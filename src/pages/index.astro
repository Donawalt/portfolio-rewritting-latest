---
import Layout from "../components/layouts/Layout.astro";
import SEO from "../components/layouts/utils/SEO.astro";
import ProjectList from '../components/molecules/ProjectList';
import Button from '../components/atoms/Button/index';
import Text from "@/components/atoms/Text/index.";

import HomeStyles from "./index.module.scss";

import { SITE, BOOKING_URI, BOOKING_SUBJECT, canonical, pageTitle, personWebsiteGraph } from "@/config/site";

import OG_IMAGE from "@/assets/images/layout/og/OG_IMAGE_HOME.jpg";

import { client } from "../assets/scripts/utils/api/sanityClient";
import { getAllProjects } from "../assets/scripts/utils/api/api";

const allProjects = await client.fetch(getAllProjects());

const mainProjects = allProjects
  .filter(p => p.category === 'design' || p.category === 'development')
  .slice(0, 9);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...personWebsiteGraph(),
    {
      "@type": "HomePage",
      "@id": canonical(),
      name: `${SITE.name} — ${SITE.role}`,
      description: SITE.description,
      url: canonical(),
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
  ],
};

---

<SEO lang="en" title={pageTitle()} description={SITE.statement} ogImage={OG_IMAGE.src} canonical={canonical()} jsonLd={homeJsonLd}>
	<Layout>
		<main class={HomeStyles.home_page}>
			<header class={HomeStyles.hero} data-hero>
				<span class={HomeStyles.label}>Freelance</span>
				<div class={HomeStyles.hero_title}>
					<h1>
						<span class={HomeStyles.line_1}>Creative</span>
						<span class={HomeStyles.line_2}>Developer</span>
					</h1>
				</div>
				<p class={HomeStyles.description}>
					Donaël Walter — design engineer &amp; creative developer based in Lyon, France.
					I turn product and brand goals into polished web experiences,
					building on branding, design, and code in one workflow, from visual identity to polished front-end development.
				</p>
				<div class={HomeStyles.cta_group}>
					<Button type="link" href="/projects">View Projects</Button>
					<Button type="link" href="mailto:contact@donaelwalter.com">Get in Touch</Button>
				</div>
			</header>

			<section>
				<div class={HomeStyles.section_title}>
					<h2>Selected Work</h2>
					<div class={HomeStyles.line}></div>
				</div>
				<ProjectList client:load projects={mainProjects} />
			</section>

			<!-- 			<section>
				<div class={HomeStyles.section_title}>
					<h2>Services</h2>
					<div class={HomeStyles.line}></div>
				</div>
				<ul class={HomeStyles.info_list}>
					{
						SITE.services.map((service) => (
							<li>
								<h3>{service.title}</h3>
								<p>{service.description}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<div class={HomeStyles.section_title}>
					<h2>Process</h2>
					<div class={HomeStyles.line}></div>
				</div>
				<ol class={HomeStyles.info_list}>
					{
						SITE.process.map((step) => (
							<li>
								<h3>{step.title}</h3>
								<p>{step.description}</p>
							</li>
						))
					}
				</ol>
			</section> -->


			<section class={HomeStyles.cta}>
				<Text type="h2" size="xl">Want to book a call ?</Text>
				<div>
					<p>
						I'm a {SITE.role.toLowerCase()} blending branding, design, and code into one workflow.
						Let's talk about your project and see how I can help, no strings attached.
						{SITE.availability}
					</p>
					<div>
						<Button type="link" href={BOOKING_URI}>
							Get in Touch
						</Button>
					</div>
				</div>
			</section>
		</main>
	</Layout>
</SEO>




