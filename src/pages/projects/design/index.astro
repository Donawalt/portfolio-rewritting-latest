---
import Layout from "../../../components/layouts/Layout.astro";
import SEO from "../../../components/layouts/utils/SEO.astro";

import { client } from "../../../assets/scripts/utils/api/sanityClient";
import { getAllProjects } from "../../../assets/scripts/utils/api/api";
//
import Heading from '../../../components/molecules/Heading';
import ProjectList from '../../../components/molecules/ProjectList'

let allProjects = await client.fetch(getAllProjects());
allProjects = allProjects.filter(el => el.category === 'design')
import OG_IMAGE from "@/assets/images/layout/og/OG_IMAGE_DESIGN_PROJECTS.jpg";

import { canonical, pageTitle, personWebsiteGraph } from "@/config/site";

const designJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...personWebsiteGraph(),
    {
      "@type": "CollectionPage",
      "@id": canonical("/projects/design"),
      name: "Design — Branding, UI/UX & Visual Identity",
      description: "Brand identity, UI/UX design, and visual projects by Donaël Walter.",
      url: canonical("/projects/design"),
      isPartOf: { "@id": `${canonical()}#website` },
    },
  ],
};
---

<SEO lang="en" title={pageTitle("Design — Branding, UI/UX & Visual Identity")} description="Browse brand identity, UI/UX design, and visual projects by Donaël Walter. From logos to complete design systems." ogImage={OG_IMAGE.src} canonical={canonical("/projects/design")} jsonLd={designJsonLd}>
	<Layout>
		<Heading client:load>
            <h1>Design</h1>
            <p>Graphic Design, UI /UX, 3D design and more ...</p>
        </Heading>
        <ProjectList projects={allProjects} client:load/>
	</Layout>
</SEO>


