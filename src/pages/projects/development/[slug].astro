---
import type { GetStaticPaths } from "astro";
import Layout from "../../../components/layouts/Layout.astro";
import SEO from "../../../components/layouts/utils/SEO.astro";
import Project from '../../../components/templates/Project.astro';
import { getProjects } from "../../../assets/scripts/utils/api/data";
import { urlImageBuilder } from "@/assets/scripts/utils/api/urlBuilder";
import { canonical, pageTitle, personWebsiteGraph } from "@/config/site";

export const getStaticPaths = (async () => {
    let allLandings: any[] = await getProjects();
    allLandings = allLandings.filter((el: { category: string; }) => el.category === 'development')

    const allLandingsLength = allLandings.length;
    return allLandings.map((page: { seoSlug: { current: any; }; }, index: number)=>{

        const nextPage = index === allLandingsLength - 1 ? allLandings[0] : allLandings[index + 1];
        return {
            params: {slug: page.seoSlug.current},
            props: {page, nextPage}
        }
    });
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { page, nextPage }: { page: any; nextPage: any } = Astro.props;

const canonicalUrl = canonical(`/projects/development/${page?.seoSlug?.current}`);
const projectJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...personWebsiteGraph(),
    {
      "@type": "CreativeWork",
      "@id": canonicalUrl,
      name: page?.seoTitle,
      description: page?.seoDescription,
      url: canonicalUrl,
      author: { "@id": `${canonical()}#person` },
      publisher: { "@id": `${canonical()}#person` },
      isPartOf: { "@id": canonical("/projects") }
    }
  ]
};
---
<SEO lang="en" title={pageTitle(page?.seoTitle)} description={page?.seoDescription} ogImage={page?.seoImage && urlImageBuilder(page?.seoImage.asset._ref, undefined, undefined, undefined, "jpg")} canonical={canonicalUrl} jsonLd={projectJsonLd}>
	<Layout>
        <Project title={page.name} subTitle={page.subtitle} cover={page.cover} tag={page?.tag} introduction={page?.introduction} skills={page?.skills} content={page.content} nextProject={nextPage} slug={slug}/>
    </Layout>
</SEO>